<sdf version="1.5">
    <world name="underwater">
        <model name="oil_rig">
            <plugin name="rock_gazebo::PluginTask" filename="rock_gazebo">
                <task model="rock_gazebo::ModelTask" />
            </plugin>

            <model name="flat_fish">
                <plugin name="rock_gazebo::PluginTask" filename="rock_gazebo">
                    <task model="rock_gazebo::ModelTask" />
                    <task name="gps" model="rock_gazebo::GPSTask" />
                </plugin>

                <link name="body">
                    <sensor name="lidar">
                        <plugin name="rock_gazebo::PluginTask" filename="rock_gazebo">
                            <task model="rock_gazebo::LaserScanTask" />
                            <task name="lidar" model="rock_gazebo::LaserScanTask" />
                        </plugin>
                    </sensor>
                </link>
             </model>
        </model>
    </world>
</sdf>
